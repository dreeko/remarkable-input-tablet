<Project>
    <PropertyGroup>
        <!-- Single source of truth for the version stamped into every assembly.
             Keep in step with the release tag: the CLI's version flag reads it,
             and reported 1.0.0 for every release up to v0.5.0 because nothing
             set it. -->
        <Version>0.7.0</Version>
    </PropertyGroup>

    <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
        <!-- Allow the Windows-targeted projects (net10.0-windows, WPF, WinForms)
             to restore and build on Linux/macOS. The produced assemblies cannot
             run on the host OS, but Core / Linux / cross-platform projects in the
             same solution build cleanly. -->
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
    </PropertyGroup>
</Project>
