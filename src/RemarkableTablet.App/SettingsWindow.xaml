<Window x:Class="RemarkableTablet.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="reMarkable Tablet Settings"
        Width="480" Height="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection -->
        <GroupBox Grid.Row="0" Header="Connection" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="Device:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="DeviceBox" Margin="0,2"
                          SelectedIndex="0">
                    <ComboBoxItem>Auto-detect (recommended)</ComboBoxItem>
                    <ComboBoxItem>reMarkable 2</ComboBoxItem>
                    <ComboBoxItem>reMarkable Paper Pro</ComboBoxItem>
                </ComboBox>
                <Label Grid.Row="1" Grid.Column="0" Content="Address:" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="AddressBox" Text="10.11.99.1" Margin="0,2" />
                <Button Grid.Row="1" Grid.Column="2" Content="Test" Width="50" Margin="4,2,0,2"
                        Click="TestConnection_Click" />
                <Label Grid.Row="2" Grid.Column="0" Content="Password:" VerticalAlignment="Center" />
                <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="PasswordBox" Margin="0,2" />
            </Grid>
        </GroupBox>

        <!-- Mapping -->
        <GroupBox Grid.Row="1" Header="Mapping" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="Orientation:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="OrientationBox" Margin="0,2"
                          SelectedIndex="0">
                    <ComboBoxItem>Portrait — USB-C port at bottom (default)</ComboBoxItem>
                    <ComboBoxItem>Landscape — USB-C port on right</ComboBoxItem>
                    <ComboBoxItem>Portrait Flipped — USB-C port at top</ComboBoxItem>
                    <ComboBoxItem>Landscape Flipped — USB-C port on left</ComboBoxItem>
                </ComboBox>
                <Label Grid.Row="1" Grid.Column="0" Content="Aspect:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FitBox" Margin="0,2"
                          SelectedIndex="0">
                    <ComboBoxItem>Crop tablet to screen shape (default)</ComboBoxItem>
                    <ComboBoxItem>Letterbox — use whole tablet, part of screen</ComboBoxItem>
                    <ComboBoxItem>Stretch — full screen, distorts strokes</ComboBoxItem>
                </ComboBox>
                <Label Grid.Row="2" Grid.Column="0" Content="Monitor:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="MonitorBox" Margin="0,2" />
                <Label Grid.Row="3" Grid.Column="0" Content="Active area:" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="AreaBox" Margin="0,2"
                         ToolTip="Part of the tablet surface to use, as x,y,w,h — fractions (0.25,0,0.5,1) or millimetres (20mm,0mm,100mm,210mm). Blank uses the whole surface." />
                <Label Grid.Row="4" Grid.Column="0" Content="Outside area:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="EdgeBox" Margin="0,2" SelectedIndex="0">
                    <ComboBoxItem>Clamp to the edge (default)</ComboBoxItem>
                    <ComboBoxItem>Ignore — lift the pen instead</ComboBoxItem>
                </ComboBox>
            </Grid>
        </GroupBox>

        <!-- Output -->
        <GroupBox Grid.Row="2" Header="Output Mode" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <RadioButton x:Name="InkRadio" Content="Windows Ink (Krita, Photoshop 2018+, Affinity)"
                                 IsChecked="True" />
                    <RadioButton x:Name="MouseRadio" Content="Mouse (no pressure — for testing only)" Margin="0,4,0,0" />
                </StackPanel>
                <Label Grid.Row="2" Grid.Column="0" Content="Pressure:" VerticalAlignment="Center" Margin="0,8,0,0" />
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="PressureBox" Margin="0,8,0,0" SelectedIndex="0">
                    <ComboBoxItem>Linear (default)</ComboBoxItem>
                    <ComboBoxItem>Soft (boost light strokes)</ComboBoxItem>
                    <ComboBoxItem>Hard (suppress light strokes)</ComboBoxItem>
                </ComboBox>
            </Grid>
        </GroupBox>

        <!-- Touch gestures -->
        <GroupBox Grid.Row="3" Header="Touch Gestures" Margin="0,0,0,8">
            <StackPanel Margin="8">
                <CheckBox x:Name="GesturesBox"
                          Content="Inject pinch / pan / rotate from the touchscreen" />
                <TextBlock Margin="20,4,0,0" TextWrapping="Wrap"
                           Foreground="Gray" FontSize="11"
                           Text="The reMarkable firmware suppresses touch while the pen is in proximity, so two-finger gestures only register when the pen is set aside." />
            </StackPanel>
        </GroupBox>

        <!-- Startup -->
        <GroupBox Grid.Row="4" Header="Startup" Margin="0,0,0,8">
            <StackPanel Margin="8">
                <CheckBox x:Name="AutoConnectBox" Content="Connect automatically when app starts" />
            </StackPanel>
        </GroupBox>

        <!-- Status -->
        <TextBlock Grid.Row="5" x:Name="StatusText" Margin="0,4,0,8"
                   Foreground="Gray" FontStyle="Italic" />

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Connect" Width="80" Margin="0,0,8,0" Click="Connect_Click" />
            <Button Content="Disconnect" Width="80" Margin="0,0,8,0" Click="Disconnect_Click" />
            <Button Content="Close" Width="60" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>