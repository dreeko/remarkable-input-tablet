<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <OutputType>WinExe</OutputType>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Self-contained single-file (untrimmed): WinForms (NotifyIcon) blocks trimming.
             Publish: dotnet publish -c Release -r win-x64 /p:SelfContained=true /p:PublishSingleFile=true -->
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\RemarkableTablet.Core\RemarkableTablet.Core.csproj"/>
        <ProjectReference Include="..\RemarkableTablet.Windows\RemarkableTablet.Windows.csproj"/>
    </ItemGroup>
</Project>
