<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- AOT publish: dotnet publish -c Release -r win-x64 /p:PublishAot=true -->
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\RemarkableTablet.Core\RemarkableTablet.Core.csproj"/>
        <ProjectReference Include="..\RemarkableTablet.Windows\RemarkableTablet.Windows.csproj"/>
    </ItemGroup>
</Project>
